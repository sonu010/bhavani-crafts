# Copy to .env.local and fill in. .env.local is gitignored.
# Bhavani Crafts — environment template

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Never put in browser-side code. Lint blocks imports outside lib/db/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_PROJECT_REF=your-project-ref

# Anthropic (Phase 4 — leave empty until AI features are enabled)
ANTHROPIC_API_KEY=
AI_MONTHLY_USD_BUDGET=20

# Observability (when wired)
SENTRY_DSN=

# Rate limiting (when wired)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Preview tokens — signs/verifies the "Preview as anonymous" JWT the
# admin generates from the Publish tab. 15-min TTL on each token.
# Generate via: `openssl rand -base64 48`
PREVIEW_TOKEN_SECRET=

# Storefront — canonical site origin (no trailing slash). Used for
# absolute URLs in JSON-LD, sitemap, robots. Defaults to the Vercel
# preview URL via VERCEL_URL at runtime when unset. Set explicitly once
# the real domain points at this deployment (e.g. https://bhavanicrafts.in).
NEXT_PUBLIC_SITE_URL=

# Storefront — WhatsApp Business number for the bulk-enquiry CTA + cart
# checkout fallback. Digits only, with country code, NO + or spaces
# (e.g. 919876543210). Public by design (it's a wa.me link). If unset,
# the bulk-enquiry CTA + WhatsApp links are hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Storefront — full Instagram profile URL for the footer contact column
# (e.g. https://instagram.com/bhavanicrafts). If unset, the link hides.
NEXT_PUBLIC_INSTAGRAM_URL=
