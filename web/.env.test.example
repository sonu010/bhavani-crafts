# LOCAL Supabase test stack — target for the vitest integration suites.
#
# DO NOT point this at production. The integration tests INSERT/DELETE
# rows; vitest.setup.ts refuses any non-local URL unless
# ALLOW_NONLOCAL_TEST_DB=1 is set.
#
# You normally do NOT copy this by hand. Run:
#   pnpm test:setup
# which boots + resets the local stack and writes web/.env.test for you
# (via scripts/write-test-env.mjs, reading `supabase status -o env`).
#
# The values below are placeholders; the real local keys are minted by
# `supabase start` and printed by `supabase status`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local anon key from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<local service_role key from `supabase status`>
PREVIEW_TOKEN_SECRET=test-preview-secret
