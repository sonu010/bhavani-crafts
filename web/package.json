{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:slow": "playwright test --headed --workers=1 --slow-mo=600",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chrome": "E2E_CHROME=1 playwright test --headed --workers=1 --project=admin-chrome",
    "test:setup": "npx --yes supabase start && npx --yes supabase db reset && node scripts/write-test-env.mjs",
    "test:e2e:setup": "pnpm test:setup && pnpm e2e:seed",
    "db:reset:test": "npx --yes supabase db reset && node scripts/write-test-env.mjs",
    "e2e:seed": "tsx e2e/seed-admin.ts",
    "backup:live": "node scripts/backup-live.mjs",
    "restore:live": "node scripts/restore-live.mjs",
    "clean:justkraft": "node ../scripts/clean-justkraft-inventory.mjs",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "launch-blockers": "tsx scripts/launch-blockers.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "file-type": "^22.0.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "shadcn": "^4.7.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@playwright/test": "^1.60.0",
    "@size-limit/preset-app": "^12.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "msw": "^2.14.6",
    "otplib": "^13.4.0",
    "prettier": "^3.8.3",
    "size-limit": "^12.1.0",
    "stream-json": "^2.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.1",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
