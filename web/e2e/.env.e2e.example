# E2E target = LOCAL Supabase stack only. Copy to e2e/.env.e2e.
# After `supabase start`, the CLI prints these values
# (`supabase status`). The anon + service_role keys below are the
# well-known LOCAL demo keys — identical on every machine, NOT secret,
# and worthless against any real project.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste local anon key from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<paste local service_role key from `supabase status`>
PREVIEW_TOKEN_SECRET=e2e-preview-secret
E2E_BASE_URL=http://127.0.0.1:3000
