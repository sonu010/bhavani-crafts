# Bhavani Crafts — project-root .gitignore
# (Each subproject also has its own .gitignore; this is the safety net.)

# ─── Secrets — never track ───
**/.env
**/.env.*
!**/.env.example

# ─── OS junk ───
.DS_Store
**/.DS_Store
Thumbs.db

# ─── Node / pnpm / Next.js ───
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
**/coverage/
**/.turbo/
**/.vercel/
*.tsbuildinfo
**/*.tsbuildinfo

# ─── Logs ───
*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# ─── IDE / editor ───
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# ─── Test artifacts ───
**/playwright-report/
**/test-results/
**/.lighthouseci/

# ─── Anthropic / Claude Code tooling (NOT the same as the claude/ working-memory folder) ───
.claude/
claude/.local/

# ─── AI scratch ───
*.scratch.md

# ─── Obsidian (user-local note-taking; not source) ───
**/.obsidian/
**/*.canvas
# Obsidian daily-note pattern (YYYY-MM-DD.md at the claude/ root)
claude/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md
# Stray Obsidian vault folder at repo root
/bhavani\ crafts/

# ─── Generated architecture pack (reproducible from scripts/extract-markdown-architecture.mjs) ───
docs/idea-architecture/generated/

# ─── Large seed fixtures (Just Kraft scrape, ~36MB) ───
# These are dev-only seed data; obtain out-of-band, do not commit.
# Keep the directory and its .gitkeep so the path exists.
data/justkraft-inventory/*.json
data/justkraft-inventory/*.csv
data/justkraft-inventory/*.checkpoint.json
data/justkraft-inventory/seed_report.json

# ─── Other large binary blobs ───
stitch_bhavani_creator_studio.zip

# ─── Backups ───
*.bak
*.orig
*.rej

# ─── Misc temp ───
/tmp/
*.tmp

# ─── Transient / one-off ───
# Owner-meeting prep documents (regenerated on demand).
claude/owner-meeting-*.md
claude/owner-meeting-*.xlsx
# State files for scripts/flip-*.mjs (transient data-flip ids).
web/scripts/.flip-publish-state.json
web/scripts/.flip-image-license-state.json
